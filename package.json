{
  "name": "@omdp/dsh-resume-stream",
  "version": "1.0.8",
  "description": "Auto-resume LLM streams cut by transport-level truncation (TRANSPORT: finish_reason missing, premature close, ECONNRESET, etc.) for all providers, with an in-message-list UI notice + toast and an execution log.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.0"
  }
}
